{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".", // 👈 就这一行
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx"
, "app/human/video-scripts/beyond-the-horoscope", "app/human/video-scripts/dawn-of-reason", "app/human/video-scripts/east-meets-west", "app/human/video-scripts/final-frontier", "app/human/video-scripts/genesis-reimagined", "app/human/video-scripts/heavenly-connections", "app/human/video-scripts/modern-miracles"  ],
  "exclude": [
    "node_modules"
  ]
}
